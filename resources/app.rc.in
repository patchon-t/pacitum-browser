// Windows resources for PacitumBrowser.exe and the update helper: icon and version information.
// 2.0.4: the publisher shown in the file's Properties > Details and in Windows lists is "Next PRJ".
#include <winver.h>

IDI_ICON1 ICON "@PACITUM_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PACITUM_RC_VERSION@,0
 PRODUCTVERSION @PACITUM_RC_VERSION@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Next PRJ"
            VALUE "FileDescription", "Pacitum Browser"
            VALUE "FileVersion", "@PACITUM_APP_VERSION@"
            VALUE "InternalName", "PacitumBrowser"
            VALUE "LegalCopyright", "Copyright (C) 2026 Next PRJ"
            VALUE "OriginalFilename", "PacitumBrowser.exe"
            VALUE "ProductName", "Pacitum Browser"
            VALUE "ProductVersion", "@PACITUM_APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
