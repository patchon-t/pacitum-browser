# Copy this file to .env and fill it in. Never share .env: the token controls the bot.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Right-click the server / channels > Copy ID (turn on Developer Mode first: User Settings > Advanced)
GUILD_ID=
RELEASE_CHANNEL_ID=
BUG_CHANNEL_ID=
SUGGEST_CHANNEL_ID=

# Optional: a role to mention when a new release is posted (right-click the role > Copy ID)
RELEASE_PING_ROLE_ID=

# GitHub repository the releases come from
GITHUB_REPO=patchon-t/pacitum-browser

# Optional: a GitHub token with "Issues: Read and write" on the repo, so /bug also opens a GitHub issue
GITHUB_TOKEN=
# bugs = issues for bug reports, all = bug reports and suggestions, none = never
GITHUB_ISSUES=bugs

# How often to check GitHub for a new release (minutes)
POLL_MINUTES=10

# Crash reports from Pacitum (POST /crash on PORT). Leave empty to turn off.
CRASH_CHANNEL_ID=
# CRASH_PER_HOUR=6
